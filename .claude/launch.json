{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "pages-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "preview",
        "--",
        "--base=/jalanflow/",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173,
      "url": "http://localhost:4173"
    }
  ]
}
